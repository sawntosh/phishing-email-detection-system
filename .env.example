# Copy to .env and fill in real values. .env is git-ignored -- never commit it.
SECRET_KEY=change-me-to-a-long-random-value
FLASK_ENV=development
# Relative sqlite paths are resolved against the project root. Leave unset to use instance/phishdetect.db
# DATABASE_URL=sqlite:///instance/phishdetect.db

# Optional: auto-create a first admin account on startup (leave unset to
# register the first user manually via /auth/register instead).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# Optional threat intelligence. Lookups only ever run when an analyst clicks
# "Run threat-intel lookup" on a result page, and are written to the audit log.
# Free VirusTotal key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# Follow redirect chains (shorteners / open redirects) with a hardened HEAD-only resolver.
ENABLE_REDIRECT_RESOLVER=false
# Max indicators checked per click (the free VirusTotal tier allows ~4 requests/minute).
THREAT_INTEL_MAX_LOOKUPS=8
# Optional: path to a domain blocklist (one domain/URL per line). Default: instance/threat_intel/blocklist.txt
# THREAT_BLOCKLIST_PATH=
